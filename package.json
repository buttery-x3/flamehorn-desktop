{
  "name": "flamehorn-desktop",
  "productName": "Flamehorn Desktop",
  "version": "0.1.0",
  "type": "module",
  "description": "A local desktop for exploring conversational material",
  "main": "dist/main.cjs",
  "private": true,
  "author": "Flamehorn Games",
  "license": "MIT",
  "engines": { "node": "24.15.0", "npm": "11.12.1" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "make": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@xyflow/svelte": "1.7.0",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "config": { "forge": "./forge.config.cjs" }
}
