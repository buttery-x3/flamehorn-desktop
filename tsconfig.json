{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "allowJs": true, "checkJs": false,
    "isolatedModules": true, "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "svelte", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "vite.config.ts"]
}
